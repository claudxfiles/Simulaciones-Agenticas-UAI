# ── LLM ──────────────────────────────────────────────────────────
# Proveedor: "anthropic" (default) o "openai" (sirve para cualquier
# endpoint OpenAI-compatible: OpenAI, LiteLLM proxy, OpenRouter, Groq…)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=sk-...
# Solo para provider=openai con endpoint custom:
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ── Persistencia de conversaciones ──────────────────────────────
# Si se define, los checkpoints del grafo van a Postgres (Supabase sirve:
# usa el connection string "Direct" del proyecto). Si se omite, memoria RAM.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Aplicacion ───────────────────────────────────────────────────
APP_NAME=mad-agents-orchestrator
APP_ENV=local            # local | staging | production
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── Guardrails ───────────────────────────────────────────────────
GUARDRAIL_MAX_INPUT_CHARS=4000

# ── Agentes worker (sql_agent y stock_agent llaman OpenAI directo) ──
OPENAI_API_KEY=sk-proj-...

# ── RAG ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
RAG_TOP_K=5

# ── Trazabilidad (paso 07) ───────────────────────────────────────
# SQLite local si se omite. En prod puede apuntar a Cloud SQL.
TRACE_DB_URL=sqlite:///./data/interactions.db
